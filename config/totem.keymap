#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE        0
#define NAV         1
#define MOUSE       2
#define MEDIA       3
#define NUM         4
#define SYM         5
#define FUN         6

// Key position definitions for 38-key Totem layout

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25  // left hand
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31  // right hand
#define THUMBS 32 33 34 35 36 37                           // thumbs

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // Timeless homerow mods for left hand
        // require-prior-idle-ms = 10500 / WPM (adjust based on typing speed)
        // Same-hand modifiers enabled (removed hold-trigger restrictions)
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Timeless homerow mods for right hand
        // Same-hand modifiers enabled (removed hold-trigger restrictions)
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        unlock {
            bindings = <&studio_unlock>;
            key-positions = <6 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
        &kp Q        &kp W        &kp E          &kp R          &kp T            &kp Y        &kp U          &kp I          &kp O        &kp P
        &hml LGUI A  &hml LALT S  &hml LCTRL D   &hml LSHFT F   &kp G            &kp H        &hmr RSHFT J   &hmr RCTRL K   &hmr LALT L  &hmr RGUI SEMICOLON
&trans  &kp Z        &kp X        &kp C          &kp V          &kp B            &kp N        &kp M          &kp COMMA      &kp DOT      &kp SLASH            &kp APOSTROPHE
                                  &lt FUN DEL    &lt NUM BSPC   &lt SYM RET      &lt MOUSE TAB &lt NAV SPACE  &lt MEDIA ESC
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
        &kp PG_UP  &kp HOME     &kp UP       &kp END      &kp INS      &trans    &trans     &trans     &trans    &trans
        &kp PG_DN  &kp LEFT     &kp DOWN     &kp RIGHT    &caps_word   &trans    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp K_UNDO &kp LS(DEL)  &kp LC(INS)  &kp LS(INS)  &kp K_AGAIN  &trans    &trans     &trans     &trans    &trans    &trans
                                &kp DEL      &kp BSPC     &kp RET      &trans    &trans     &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
        &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans       &trans    &trans     &trans     &trans    &trans
        &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans       &trans    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp K_UNDO      &kp LS(DEL)     &kp LC(INS)     &kp LS(INS)      &kp K_AGAIN  &trans    &trans     &trans     &trans    &trans    &trans
                                        &mkp RCLK       &mkp LCLK        &mkp MB2     &trans    &trans     &trans
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
        &trans      &trans      &kp C_VOL_UP  &trans      &trans    &trans    &trans     &trans     &trans    &trans
        &trans      &kp C_PREV  &kp C_VOL_DN  &kp C_NEXT  &trans    &trans    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &trans      &trans      &trans        &trans      &trans    &trans    &trans     &trans     &trans    &trans    &trans
                                &kp C_MUTE    &kp C_PP    &kp C_STOP &trans    &trans     &trans
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
        &trans    &trans    &trans     &trans     &trans    &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT
        &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp EQUAL  &kp N4  &kp N5   &kp N6  &kp SEMI
&trans  &trans    &trans    &trans     &trans     &trans    &kp BSLH   &kp N1  &kp N2   &kp N3  &kp GRAVE  &trans
                            &trans     &trans     &trans    &kp MINUS  &kp N0  &kp DOT
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
        &trans    &trans    &trans     &trans     &trans    &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC
        &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp PLUS   &kp DLLR  &kp PRCNT  &kp CARET  &kp COLON
&trans  &trans    &trans    &trans     &trans     &trans    &kp PIPE   &kp EXCL  &kp AT     &kp HASH   &kp TILDE  &trans
                            &trans     &trans     &trans    &kp UNDER  &kp LPAR  &kp RPAR
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
        &trans    &trans    &trans     &trans     &trans    &kp PSCRN        &kp F7  &kp F8     &kp F9     &kp F12
        &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp SLCK         &kp F4  &kp F5     &kp F6     &kp F11
&trans  &trans    &trans    &trans     &trans     &trans    &kp PAUSE_BREAK  &kp F1  &kp F2     &kp F3     &kp F10  &trans
                            &trans     &trans     &trans    &kp TAB          &kp SPACE  &kp K_APP
            >;
        };
    };
};
